# Copie este arquivo para .env e ajuste os valores conforme o seu ambiente.
# O .env não é versionado (veja .gitignore); este .env.example serve de referência.

# Porta em que a API sobe.
PORT=3000

# Conexão com o MongoDB usada pela API.
MONGODB_URI=mongodb://127.0.0.1:27017/gestao-de-alunos

# Segredo e expiração usados para assinar os tokens JWT.
JWT_SECRET=segredo-dev-gestao-de-alunos
JWT_EXPIRES_IN=8h

# --- Usado apenas pelos testes automatizados ---

# Banco separado para os testes, para não sujar o banco de desenvolvimento.
# Os testes leem esta variável; se ela não existir, caem em MONGODB_URI.
MONGODB_URI_TEST=mongodb://127.0.0.1:27017/gestao-de-alunos-test

# Credenciais do administrador pré-cadastrado pelo seed, usadas pelo helper de login.
ADMIN_EMAIL=admin@escola.com
ADMIN_SENHA=admin123
